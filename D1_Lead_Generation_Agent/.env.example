# Required for live discovery
SERPER_API_KEY=

# Required for Gemini enrichment/scoring
GEMINI_API_KEY=

# Model can be changed if your AI Studio account uses another available model.
GEMINI_MODEL=gemini-3.8-flash

# Number of search results per query
SEARCH_RESULTS=8

# Maximum pages fetched per run
MAX_PAGES=12

# Seconds between direct page fetches
FETCH_DELAY=0.8

# Cache TTL in hours
CACHE_TTL_HOURS=24
